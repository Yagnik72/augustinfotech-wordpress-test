INSERT INTO `wp_email_log` VALUES (1,'referral1@gmail.com','Your augustinfotech-test account has been created!','<!DOCTYPE html>\n<html lang=\"en-US\">\n	<head>\n		<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n		<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\">\n		<title>augustinfotech-test</title>\n	<style type=\"text/css\">@media screen and (max-width: 600px){#template_header_image,#header_wrapper{padding: 16px 10px 0 !important;}#header_wrapper h1{font-size: 24px !important;}#body_content_inner_cell{padding: 10px !important;}#body_content_inner{font-size: 12px !important;}.email-additional-content{padding-top: 16px !important;}}</style>\n</head>\n	<body leftmargin=\"0\" marginwidth=\"0\" topmargin=\"0\" marginheight=\"0\" offset=\"0\" style=\"background-color: #fff; padding: 0; text-align: center;\" bgcolor=\"#fff\">\n		<table width=\"100%\" id=\"outer_wrapper\" style=\"background-color: #fff;\" bgcolor=\"#fff\">\n			<tr>\n				<td><!-- Deliberately empty to support consistent sizing and layout across multiple email clients. --></td>\n				<td width=\"600\">\n					<div id=\"wrapper\" dir=\"ltr\" style=\"margin: 0 auto; padding: 24px 0; width: 100%; max-width: 600px; -webkit-text-size-adjust: none;\" width=\"100%\">\n						<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" height=\"100%\" width=\"100%\" id=\"inner_wrapper\" style=\"background-color: #fff; border-radius: 8px;\" bgcolor=\"#fff\">\n							<tr>\n								<td align=\"center\" valign=\"top\">\n																			<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n											<tr>\n												<td id=\"template_header_image\" style=\"padding: 32px 32px 0;\">\n													<p class=\"email-logo-text\" style=\'color: #32373c; font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; font-size: 18px; margin-bottom: 0; text-align: left;\' align=\"left\">augustinfotech-test</p>												</td>\n											</tr>\n										</table>\n																		<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" id=\"template_container\" style=\"box-shadow: none; background-color: #fff; border: 0; border-radius: 3px;\" bgcolor=\"#fff\">\n										<tr>\n											<td align=\"center\" valign=\"top\">\n												<!-- Header -->\n												<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" id=\"template_header\" style=\'background-color: #fff; color: #1e1e1e; border-bottom: 0; font-weight: bold; line-height: 100%; vertical-align: middle; font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; border-radius: 3px 3px 0 0;\' bgcolor=\"#fff\">\n													<tr>\n														<td id=\"header_wrapper\" style=\"padding: 20px 32px 0; display: block;\">\n															<h1 style=\'font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; font-size: 32px; font-weight: 700; letter-spacing: -1px; line-height: 120%; margin: 0; color: #1e1e1e; background-color: inherit; text-align: left;\' bgcolor=\"inherit\">Welcome to augustinfotech-test</h1>\n														</td>\n													</tr>\n												</table>\n												<!-- End Header -->\n											</td>\n										</tr>\n										<tr>\n											<td align=\"center\" valign=\"top\">\n												<!-- Body -->\n												<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" id=\"template_body\">\n													<tr>\n														<td valign=\"top\" id=\"body_content\" style=\"background-color: #fff;\" bgcolor=\"#fff\">\n															<!-- Content -->\n															<table border=\"0\" cellpadding=\"20\" cellspacing=\"0\" width=\"100%\">\n																<tr>\n																	<td valign=\"top\" id=\"body_content_inner_cell\" style=\"padding: 20px 32px 32px;\">\n																		<div id=\"body_content_inner\" style=\'color: #4b4b4b; font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; font-size: 16px; line-height: 150%; text-align: left;\' align=\"left\">\n\n<div class=\"email-introduction\" style=\"padding-bottom: 24px;\">\n<p style=\"margin: 0 0 16px;\">Hi referral1,</p>\n		<p style=\"margin: 0 0 16px;\">Thanks for creating an account on augustinfotech-test. Here’s a copy of your user details.</p>\n	<div class=\"hr hr-top\" style=\"border-bottom: 1px solid #1e1e1e; opacity: .2; margin: 16px 0; margin-top: 32px;\"></div>\n		<p style=\"margin: 0 0 16px;\">Username: <b>referral1</b></p>\n					<p style=\"margin: 0 0 16px;\"><a href=\"http://augustinfotech-test.local/my-account/lost-password/?action=newaccount&amp;key=C9asvOLS78P0eISO8sgW&amp;login=referral1\" style=\"color: #32373c; font-weight: normal; text-decoration: underline;\">Set your new password.</a></p>\n		<div class=\"hr hr-bottom\" style=\"border-bottom: 1px solid #1e1e1e; opacity: .2; margin: 16px 0; margin-bottom: 32px;\"></div>\n	<p style=\"margin: 0 0 16px;\">You can access your account area to view orders, change your password, and more via the link below:</p>\n	<p style=\"margin: 0 0 16px;\"><a href=\"http://augustinfotech-test.local/my-account/\" style=\"color: #32373c; font-weight: normal; text-decoration: underline;\">My account</a></p>\n</div>\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td class=\"email-additional-content email-additional-content-aligned\" style=\'color: #1e1e1e; font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; padding: 32px 0 0;\'>\n<p style=\"text-align: left; margin: 0 0 16px;\" align=\"left\">We look forward to seeing you soon.</p>\n</td></tr></table>																		</div>\n																	</td>\n																</tr>\n															</table>\n															<!-- End Content -->\n														</td>\n													</tr>\n												</table>\n												<!-- End Body -->\n											</td>\n										</tr>\n									</table>\n								</td>\n							</tr>\n							<tr>\n								<td align=\"center\" valign=\"top\">\n									<!-- Footer -->\n									<table border=\"0\" cellpadding=\"10\" cellspacing=\"0\" width=\"100%\" id=\"template_footer\">\n										<tr>\n											<td valign=\"top\" style=\"padding: 0; border-radius: 0;\">\n												<table border=\"0\" cellpadding=\"10\" cellspacing=\"0\" width=\"100%\">\n													<tr>\n														<td colspan=\"2\" valign=\"middle\" id=\"credit\" style=\'border-radius: 0; border: 0; border-top: 1px solid rgba(0,0,0,.2); font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; font-size: 12px; line-height: 140%; text-align: center; padding: 32px; color: #787c82;\' align=\"center\">\n															<p style=\"margin: 0;\">augustinfotech-test — Built with <a href=\"https://woocommerce.com\" style=\"font-weight: normal; text-decoration: underline; color: #787c82;\">WooCommerce</a></p>\n														</td>\n													</tr>\n												</table>\n											</td>\n										</tr>\n									</table>\n									<!-- End Footer -->\n								</td>\n							</tr>\n						</table>\n					</div>\n				</td>\n				<td><!-- Deliberately empty to support consistent sizing and layout across multiple email clients. --></td>\n			</tr>\n		</table>\n	</body>\n</html>\n','Content-Type: text/html\r\nReply-to: augustinfotech-test <dev-email@wpengine.local>\r\n','false','2025-04-29 11:06:50','','127.0.0.1',1,NULL);
INSERT INTO `wp_email_log` VALUES (2,'referral1@gmail.com','[augustinfotech-test] Password Changed','Hi referral1,\n\nThis notice confirms that your password was changed on augustinfotech-test.\n\nIf you did not change your password, please contact the Site Administrator at\ndev-email@wpengine.local\n\nThis email has been sent to referral1@gmail.com\n\nRegards,\nAll at augustinfotech-test\nhttp://augustinfotech-test.local','','false','2025-04-29 11:08:20','','127.0.0.1',1,NULL);
