table border=\"0\" cellpadding=\"10\" cellspacing=\"0\" width=\"100%\" id=\"template_footer\">\n										<tr>\n											<td valign=\"top\" style=\"padding: 0; border-radius: 0;\">\n												<table border=\"0\" cellpadding=\"10\" cellspacing=\"0\" width=\"100%\">\n													<tr>\n														<td colspan=\"2\" valign=\"middle\" id=\"credit\" style=\'border-radius: 0; border: 0; border-top: 1px solid rgba(0,0,0,.2); font-family: \"Helvetica Neue\",Helvetica,Roboto,Arial,sans-serif; font-size: 12px; line-height: 140%; text-align: center; padding: 32px; color: #787c82;\' align=\"center\">\n															<p style=\"margin: 0;\">augustinfotech-test — Built with <a href=\"https://woocommerce.com\" style=\"font-weight: normal; text-decoration: underline; color: #787c82;\">WooCommerce</a></p>\n														</td>\n													</tr>\n												</table>\n											</td>\n										</tr>\n									</table>\n									<!-- End Footer -->\n								</td>\n							</tr>\n						</table>\n					</div>\n				</td>\n				<td><!-- Deliberately empty to support consistent sizing and layout across multiple email clients. --></td>\n			</tr>\n		</table>\n	</body>\n</html>\n','Content-Type: text/html\r\nReply-to: augustinfotech-test <dev-email@wpengine.local>\r\n','false','2025-04-29 11:08:57','','127.0.0.1',1,NULL);
